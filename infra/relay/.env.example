# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
# Set both to the same zone (e.g. *.s5code.dpdns.org) when the API and
# managed-endpoint hostnames share one zone.
RELAY_API_ZONE_NAME=s5code.dpdns.org
RELAY_TUNNEL_ZONE_NAME=s5code.dpdns.org

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.s5code.dpdns.org

# Required: Neon Postgres database (replaces hosted PlanetScale)
# A pooled or direct Postgres connection string. The relay points a Cloudflare
# Hyperdrive at this origin so the Worker talks to Neon through the edge, not
# the public internet. Migrations in ./migrations/postgres are applied against
# this URL out-of-band (see the relay README).
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the relay JWT template.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_AUDIENCE=s5-code-relay

# Optional: Apple Push Notification service
# Required only for mobile push notifications and Live Activities. When these
# are absent the relay deploys and links environments, but mobile
# notifications are disabled. Get the values from your Apple Developer account;
# use `sandbox` for development APNs credentials and `production` for production.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=club.touchtech.s5code
APNS_PRIVATE_KEY=