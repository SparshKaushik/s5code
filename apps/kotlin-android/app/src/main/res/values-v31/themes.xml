<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      API 31+ has a real splash screen, so the launch theme configures that
      instead of painting a window background. The platform then hands the exit
      animation to the activity, which is what makes the splash-to-app
      transition continuous rather than a cut.

      No `windowSplashScreenAnimationDuration`: the icon is static, and claiming
      an animation duration only delays the handoff.
    -->
    <style name="Theme.S5Code.Launch" parent="Theme.S5Code">
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
